// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// Users Table (FR-AUTH-01, FR-AUTH-02, FR-AUTH-03)
// ============================================================================
model User {
  id                String        @id @default(cuid())
  name              String
  email             String        @unique
  password          String?       // Hashed with Bcrypt (NFR-SEC-01), null for OAuth users
  paydayDate        Int?          // 1-31, for routine income cycle
  themePreference   String        @default("light") // "light" or "dark" (FR-AUTH-03)
  
  // Legacy Income allocation percentages (removed in favor of Pocket-level allocation)
  // allocationEmergency   Int       @default(0)  
  // allocationSavings     Int       @default(0)  
  // allocationWishlist    Int       @default(0)  

  lastLoginAt DateTime? @db.Timestamp(0)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  pockets           Pocket[]
  categories        Category[]
  transactions      Transaction[]
  incomeRecords     IncomeRecord[]
  subscription      Subscription?
  ktmVerification   KtmVerification?

  @@map("users")
}

// ============================================================================
// Pockets Table (FR-PKT-01 through FR-PKT-04)
// The 4 Financial Pockets: Main, Emergency, Savings, Wishlist
// ============================================================================
enum PocketType {
  MAIN      // Liquid main wallet (FR-PKT-01)
  EMERGENCY // Emergency shield with target (FR-PKT-02)
  SAVINGS   // Growth asset savings (FR-PKT-03)
  WISHLIST  // Goal achievement with progress tracking (FR-PKT-04)
  CUSTOM    // User created custom pocket
}

model Pocket {
  id            String        @id @default(cuid())
  userId        String
  name          String
  type          PocketType
  balance       Decimal       @default(0.00) @db.Decimal(15, 2)
  targetAmount  Decimal?      @db.Decimal(15, 2) // For Emergency and Wishlist
  status        String        @default("active") // "active" or "completed" (for Wishlist)
  
  allocation    Int           @default(0)        // Percentage (0-100) of income allocated to this pocket
  color         String        @default("#6366f1") // Theme color for the pocket
  icon          String        @default("Wallet") // Icon name
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  categories    Category[]    // Categories linked to this pocket

  @@map("pockets")
}

// ============================================================================
// Categories Table (FR-CAT-01 through FR-CAT-04)
// Master data for user-defined transaction categories
// ============================================================================
enum CategoryType {
  NEED // Kebutuhan (Necessity)
  WANT // Keinginan (Desire)
}

model Category {
  id          String        @id @default(cuid())
  userId      String
  pocketId    String?       // Optional link to a specific pocket (Envelope Budgeting)
  name        String
  type        CategoryType  // "NEED" or "WANT" (BR-02)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pocket      Pocket?       @relation(fields: [pocketId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@unique([userId, name]) // User cannot have duplicate category names
  @@map("categories")
}

// ============================================================================
// Transactions Table (FR-TRX-01, FR-TRX-03)
// All financial flow records: income and expenses
// ============================================================================
enum TransactionType {
  INCOME_ROUTINE  // Regular monthly income (FR-IN-01)
  INCOME_BONUS    // Bonus/insidental income (FR-IN-01)
  EXPENSE         // Expense transaction (FR-TRX-03)
  TRANSFER        // Inter-pocket transfer (e.g. Rollover)
}

enum TransactionStatus {
  PENDING    // Waiting for user confirmation (for auto-generated income)
  COMPLETED  // Confirmed/completed
  CANCELLED  // Cancelled or rejected
}

model Transaction {
  id          String        @id @default(cuid())
  userId      String
  pocketId    String
  categoryId  String?       // Optional for income transactions
  type        TransactionType
  amount      Decimal       @db.Decimal(15, 2)
  date        DateTime      @db.Date
  status      TransactionStatus @default(COMPLETED) // PENDING for auto-generated income
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pocket      Pocket        @relation(fields: [pocketId], references: [id], onDelete: Restrict)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@map("transactions")
}

// ============================================================================
// Income Records Table (FR-IN-02, FR-IN-03)
// Tracks income events and distribution allocations
// ============================================================================
model IncomeRecord {
  id              String        @id @default(cuid())
  userId          String
  type            TransactionType // INCOME_ROUTINE or INCOME_BONUS
  amount          Decimal       @db.Decimal(15, 2)
  
  // Distribution breakdown (FR-IN-03)
  allocationMain        Decimal   @default(0.00) @db.Decimal(15, 2)
  allocationEmergency   Decimal   @default(0.00) @db.Decimal(15, 2)
  allocationSavings     Decimal   @default(0.00) @db.Decimal(15, 2)
  allocationWishlist    Decimal   @default(0.00) @db.Decimal(15, 2)
  
  notes           String?
  recordedAt      DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("income_records")
}

// ============================================================================
// Daily Performance Log (For FR-DASH-04 AI Roaster, FR-EVAL-01)
// Used to track daily spending patterns for AI analysis
// ============================================================================
model DailyPerformance {
  id              String        @id @default(cuid())
  userId          String
  date            DateTime      @db.Date
  dailyAllowance  Decimal       @db.Decimal(15, 2) // Calculated jatah harian
  totalSpent      Decimal       @default(0.00) @db.Decimal(15, 2)
  percentageUsed  Decimal       @default(0.00) @db.Decimal(8, 2)
  status          String        // "GREEN", "YELLOW", "RED" (FR-DASH-02)
  surplusTransferred Decimal?   @db.Decimal(15, 2) // For FR-EVAL-01
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, date])
  @@map("daily_performance")
}

// ============================================================================
// Subscription Table — Sistem Paket (Trial / Student / Premium)
// ============================================================================
enum SubscriptionPlan {
  TRIAL    // 14 hari gratis (default saat daftar)
  STUDENT  // Gratis selamanya (verifikasi KTM/email .ac.id)
  PREMIUM  // Rp 49.000/bulan (bayar via Duitku)
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
}

model Subscription {
  id            String             @id @default(cuid())
  userId        String             @unique
  plan          SubscriptionPlan   @default(TRIAL)
  status        SubscriptionStatus @default(ACTIVE)
  startedAt     DateTime           @default(now())
  expiresAt     DateTime?          // null = unlimited (Student & Premium belum expired)
  cancelledAt   DateTime?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@map("subscriptions")
}

// ============================================================================
// Payment Table — Riwayat Pembayaran Duitku
// ============================================================================
model Payment {
  id              String       @id @default(cuid())
  subscriptionId  String
  merchantOrderId String       @unique  // ID unik untuk Duitku
  amount          Int          // dalam Rupiah
  status          String       @default("PENDING") // PENDING | SUCCESS | FAILED | EXPIRED
  paymentMethod   String?      // VA, QRIS, dll
  paymentUrl      String?      // URL redirect ke Duitku
  duitkuReference String?      // Referensi dari Duitku setelah sukses
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  subscription    Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

// ============================================================================
// KTM Verification Table — Verifikasi Mahasiswa via Scan KTM
// ============================================================================
enum KtmVerificationStatus {
  PENDING    // Baru diupload, menunggu proses
  APPROVED   // KTM valid, user sudah jadi Student
  REJECTED   // KTM tidak valid
}

model KtmVerification {
  id            String                  @id @default(cuid())
  userId        String                  @unique
  imageUrl      String                  // URL foto KTM (base64 atau cloud storage)
  extractedName String?                 // Nama yang dibaca AI dari KTM
  extractedNim  String?                 // NIM
  extractedUniv String?                 // Nama universitas
  extractedYear String?                 // Tahun masuk / angkatan
  status        KtmVerificationStatus   @default(PENDING)
  rejectedReason String?
  verifiedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ktm_verifications")
}

// ============================================================================
// OTP Codes Table — For email verification & password reset
// ============================================================================
model OtpCode {
  id        String    @id @default(cuid())
  email     String
  code      String    // 6-digit OTP
  purpose   String    // "REGISTER" | "RESET_PASSWORD"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
  @@map("otp_codes")
}
