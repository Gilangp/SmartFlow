# Database (Supabase / PostgreSQL)
# DATABASE_URL is the pooled connection string (used by Next.js app in Vercel)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL is the direct connection string (used for migrations)
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"

# NextAuth / JWT (for future authentication enhancement)
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# App Configuration
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ── AI API Keys ───────────────────────────────────────────────────────────────
# Gemini (Provider UTAMA) — https://aistudio.google.com/apikey
GEMINI_API_KEY="AIzaSy_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# OpenAI (Fallback berbayar, opsional) — https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Hugging Face Inference API — Token Rotation (2 Akun = 2x kuota gratis)
# Dapatkan token di: https://huggingface.co/settings/tokens (pilih type: Read)
# PRIMARY   = token dari Akun HF ke-1
# SECONDARY = token dari Akun HF ke-2 (opsional, tapi sangat direkomendasikan)
HF_TOKEN_PRIMARY="hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
HF_TOKEN_SECONDARY="hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ── OCR Backend (FastAPI di Hugging Face Spaces) ──────────────────────────────
# URL Space setelah deploy, contoh: https://username-smartflow-ocr-backend.hf.space
OCR_BACKEND_URL="https://gilangppp-smartflow-ocr-backend.hf.space"
# Harus sama persis dengan OCR_API_KEY yang diset di HF Spaces Secrets
OCR_API_KEY="GANTI_DENGAN_STRING_RANDOM_PANJANG_ANDA"

# ── Email Service (Resend) ────────────────────────────────────────────────────
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXX"
# Gunakan onboarding@resend.dev jika tidak punya domain sendiri
RESEND_FROM_EMAIL="Finto <onboarding@resend.dev>"

# ── Midtrans Payment Gateway ──────────────────────────────────────────────────
MIDTRANS_SERVER_KEY="SB-Mid-server-XXXXXXXXXXXXXXXXXXXXXXXX"
MIDTRANS_CLIENT_KEY="SB-Mid-client-XXXXXXXXXXXXXXXXXXXXXXXX"
MIDTRANS_IS_PRODUCTION="false"
